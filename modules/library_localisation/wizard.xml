<?xml version="1.0"?>
<tryton>
    <data>
        <!-- #################### -->
        <!-- # Move Exemplaries # -->
        <!-- #################### -->
        <record model="ir.action.wizard" id="act_library_move_exemplary">
            <field name="name">Move Exemplaries</field>
            <field name="wiz_name">library.localisation.move</field>
        </record>
        <record model="ir.action.keyword" id="act_library_move_exemplary_keyword">
            <field name="keyword">form_action</field>
            <field name="model">library.book.exemplary,-1</field>
            <field name="action" ref="act_library_move_exemplary"/>
        </record>
        <record model="ir.action.keyword" id="act_library_move_exemplary_shelf_keyword">
            <field name="keyword">form_action</field>
            <field name="model">library.localisation.shelf,-1</field>
            <field name="action" ref="act_library_move_exemplary"/>
        </record>
        <!-- ############################## -->
        <!-- # Select Exemplary and Shelf # -->
        <!-- ############################## -->
        <record model="ir.ui.view" id="move_exemplaries_shelf_view_form">
            <field name="model">library.localisation.move.select</field>
            <field name="type">form</field>
            <field name="name">move_exemplaries_shelf_form</field>
        </record>

        <!-- ##################### -->
        <!-- # Store Exemplaries # -->
        <!-- ##################### -->
        <record model="ir.action.wizard" id="act_library_store_exemplary">
            <field name="name">Store Exemplaries</field>
            <field name="wiz_name">library.storehouse.put_in</field>
        </record>
        <record model="ir.action.keyword" id="act_library_store_exemplary_keyword">
            <field name="keyword">form_action</field>
            <field name="model">library.book.exemplary,-1</field>
            <field name="action" ref="act_library_store_exemplary"/>
        </record>
        <!-- #################### -->
        <!-- # Select Exemplary # -->
        <!-- #################### -->
        <record model="ir.ui.view" id="store_exemplaries_view_form">
            <field name="model">library.storehouse.put_in.select</field>
            <field name="type">form</field>
            <field name="name">store_exemplaries_form</field>
        </record>

        <!-- ######################## -->
        <!-- # Take out Exemplaries # -->
        <!-- ######################## -->
        <record model="ir.action.wizard" id="act_library_take_out_exemplary">
            <field name="name">Take out Exemplaries</field>
            <field name="wiz_name">library.storehouse.take_out</field>
        </record>
        <record model="ir.action.keyword" id="act_library_take_out_stocks_keyword">
            <field name="keyword">form_action</field>
            <field name="model">library.storehouse,-1</field>
            <field name="action" ref="act_library_take_out_exemplary"/>
        </record>
        <!-- #################### -->
        <!-- # Select Exemplary # -->
        <!-- #################### -->
        <record model="ir.ui.view" id="take_out_exemplaries_view_form">
            <field name="model">library.storehouse.take_out.select</field>
            <field name="type">form</field>
            <field name="name">take_out_exemplaries_form</field>
        </record>
    </data>
</tryton>
