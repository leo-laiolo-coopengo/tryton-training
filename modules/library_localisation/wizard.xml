            <field name="name">storehouse_exemplaries_form</field>
        </record>

        <!-- ######################## -->
        <!-- # Move out Exemplaries # -->
        <!-- ######################## -->
        <record model="ir.action.wizard" id="act_library_storehouse_out_exemplary">
